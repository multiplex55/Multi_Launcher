+
+    #[test]
+    fn f11_requires_focused_root_and_no_input_owner() {
+        let (mut probe, _jobs, _outcome_tx) = test_probe(CaptureTrigger::F11);
+        let ctx = egui::Context::default();
+        let f11 = || Event::Key {
+            key: Key::F11,
+            physical_key: Some(Key::F11),
+            pressed: true,
+            repeat: false,
+            modifiers: Modifiers::NONE,
+        };
+        let release_f11 = || Event::Key {
+            key: Key::F11,
+            physical_key: Some(Key::F11),
+            pressed: false,
+            repeat: false,
+            modifiers: Modifiers::NONE,
+        };
+        let mut owned = eligible();
+        owned.modal_or_key_capture_owner = true;
+        run_frame(&mut probe, &ctx, raw_input(vec![f11()], true), owned);
+        assert_eq!(probe.phase, ProbePhase::Armed);
+        run_frame(
+            &mut probe,
+            &ctx,
+            raw_input(vec![release_f11()], true),
+            eligible(),
+        );
+        assert_eq!(probe.phase, ProbePhase::Armed);
+        run_frame(&mut probe, &ctx, raw_input(vec![f11()], false), eligible());
+        assert_eq!(probe.phase, ProbePhase::Armed);
+        run_frame(
+            &mut probe,
+            &ctx,
+            raw_input(vec![release_f11()], false),
+            eligible(),
+        );
+        assert_eq!(probe.phase, ProbePhase::Armed);
+        run_frame(&mut probe, &ctx, raw_input(vec![f11()], true), eligible());
+        assert_eq!(probe.phase, ProbePhase::Issued);
+    }
