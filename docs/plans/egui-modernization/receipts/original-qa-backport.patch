+    #[test]
+    fn failed_save_handoff_is_terminal_and_does_not_claim_saving() {
+        let (mut probe, jobs, _outcome_tx) = test_probe(CaptureTrigger::Startup);
+        let receipt = probe.receipt.clone();
+        probe
+            .writer_tx
+            .try_send(WriterJob::AwaitReply(receipt.clone()))
+            .unwrap();
+        probe
+            .writer_tx
+            .try_send(WriterJob::Failure(receipt.clone()))
+            .unwrap();
+        probe.phase = ProbePhase::AwaitingReply;
+        probe.logic_frame_id = 3;
+        probe.expected_reply_logic_frame_id = Some(3);
+        probe.pending_reply = Some(PendingScreenshotReply {
+            image: Arc::new(ColorImage::new([1, 1], egui::Color32::WHITE)),
+            evidence: ScreenshotReplyEvidence {
+                viewport_id: "ROOT",
+                logic_frame_id: 3,
+                received_at_unix_ms: 3,
+                width: 1,
+                height: 1,
+                correlation: "sole outstanding ROOT request; egui 0.27 reply has no UserData token",
+            },
+        });
+        probe.retained_pass = Some(RetainedPassMarker {
+            logic_frame_id: 3,
+            ui_pass_id: 3,
+            ui_pass_index: 0,
+            eligibility: eligible(),
+            evidence: Some(evidence(3, 3, 0)),
+        });
+        let ctx = egui::Context::default();
+        let _ = ctx.run(egui::RawInput::default(), |ctx| {
+            probe.finish_retained_ui_frame(ctx, eligible());
+        });
+
+        assert_eq!(probe.phase, ProbePhase::Failed);
+        assert!(
+            probe
+                .receipt
+                .failure
+                .as_deref()
+                .unwrap()
+                .contains("queue screenshot save")
+        );
+        assert!(matches!(jobs.try_recv(), Ok(WriterJob::AwaitReply(_))));
+        assert!(matches!(jobs.try_recv(), Ok(WriterJob::Failure(_))));
+    }
