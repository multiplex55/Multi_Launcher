+            current_ui_pass_index: 0,
+            retained_pass: None,
+            issue_logic_frame_id: None,
+            expected_reply_logic_frame_id: None,
+            pending_reply: None,
+            receipt: CompletionReceipt::new(&request),
+            writer_tx,
+            writer_rx: outcome_rx,
+        };
+        (probe, writer_rx, outcome_tx)
+    }
+
+    fn evidence(frame: u64, pass: u64, index: u32) -> FrameEvidence {
+        FrameEvidence {
+            viewport_id: "ROOT",
+            logic_frame_id: frame,
+            ui_pass_id: pass,
+            ui_pass_index: index,
+            evidence_stage: "test",
+            completed_at_unix_ms: frame,
+            query: "test query".into(),
+            result_generation: 7,
+            pixels_per_point: Some(1.0),
+            native_pixels_per_point: Some(1.0),
+            zoom_factor: 1.0,
+            logical_root_visible: true,
+            root_minimized_reported: None,
+            root_visible: true,
+            viewport_focused: true,
+            ocr_owner: false,
+            tool_owner: false,
+            modal_or_key_capture_owner: false,
+            eligible: true,
+        }
+    }
+
+    fn run_frame(
+        probe: &mut FramebufferProbe,
+        ctx: &egui::Context,
+        input: egui::RawInput,
+        eligibility: SurfaceEligibility,
+    ) {
+        let _ = ctx.run(input, |ctx| {
+            probe.begin_root_logic(ctx, Some(eligibility));
+            probe.start_ui_pass(0);
+            if let Some(pass) = probe.current_ui_pass_id {
+                if probe.phase == ProbePhase::Ready {
+                    probe.issue_screenshot_if_ready(
+                        ctx,
+                        eligibility,
+                        evidence(probe.logic_frame_id, pass, 0),
+                    );
+                }
+                let capture_evidence = (probe.phase == ProbePhase::Issued
+                    && probe
+                        .issue_logic_frame_id
+                        .is_some_and(|issue| probe.logic_frame_id > issue))
+                .then(|| evidence(probe.logic_frame_id, pass, 0));
+                probe.finish_ui_pass(eligibility, capture_evidence);
+            }
+            probe.finish_retained_ui_frame(ctx, eligibility);
+        });
+    }
+
+    fn advance_to_reply_wait(
+        probe: &mut FramebufferProbe,
+        ctx: &egui::Context,
+        jobs: &Receiver<WriterJob>,
+    ) {
+        if probe.phase == ProbePhase::Armed {
+            run_frame(probe, ctx, egui::RawInput::default(), eligible());
+            assert_eq!(probe.phase, ProbePhase::Ready);
+        } else {
+            assert_eq!(probe.phase, ProbePhase::Ready);
+        }
+        run_frame(probe, ctx, egui::RawInput::default(), eligible());
+        assert_eq!(probe.phase, ProbePhase::Issued);
+        run_frame(probe, ctx, egui::RawInput::default(), eligible());
+        assert_eq!(probe.phase, ProbePhase::AwaitingReply);
+        assert!(matches!(jobs.try_recv(), Ok(WriterJob::AwaitReply(_))));
+    }
+
+    #[test]
+    fn startup_uses_issue_capture_and_reply_frames() {
+        let (mut probe, jobs, _outcome_tx) = test_probe(CaptureTrigger::Startup);
+        let ctx = egui::Context::default();
+        advance_to_reply_wait(&mut probe, &ctx, &jobs);
+        let image = Arc::new(ColorImage::new([1, 1], egui::Color32::WHITE));
+        run_frame(
+            &mut probe,
+            &ctx,
+            raw_input(
+                vec![Event::Screenshot {
+                    viewport_id: ViewportId::ROOT,
+                    image,
+                }],
+                true,
+            ),
+            eligible(),
+        );
+        assert_eq!(probe.phase, ProbePhase::Saving);
+        assert_eq!(probe.receipt.issued.as_ref().unwrap().logic_frame_id, 2);
+        assert_eq!(probe.receipt.captured.as_ref().unwrap().logic_frame_id, 3);
+        assert_eq!(
+            probe
+                .receipt
+                .screenshot_received
+                .as_ref()
+                .unwrap()
+                .logic_frame_id,
+            4
+        );
+        assert!(matches!(jobs.try_recv(), Ok(WriterJob::Save { .. })));
+    }
+
+    #[test]
+    fn unsolicited_and_foreign_viewport_replies_are_rejected() {
+        let (mut probe, jobs, _outcome_tx) = test_probe(CaptureTrigger::Startup);
+        let ctx = egui::Context::default();
+        let image = Arc::new(ColorImage::new([1, 1], egui::Color32::WHITE));
+        run_frame(
+            &mut probe,
+            &ctx,
+            raw_input(
+                vec![Event::Screenshot {
+                    viewport_id: ViewportId::ROOT,
+                    image: Arc::clone(&image),
+                }],
+                true,
+            ),
+            eligible(),
+        );
+        assert!(probe.pending_reply.is_none());
+        advance_to_reply_wait(&mut probe, &ctx, &jobs);
+        let foreign = ViewportId::from_hash_of("foreign viewport");
+        run_frame(
+            &mut probe,
+            &ctx,
+            raw_input(
+                vec![Event::Screenshot {
+                    viewport_id: foreign,
+                    image,
+                }],
+                true,
+            ),
+            eligible(),
+        );
+        assert_eq!(probe.phase, ProbePhase::AwaitingReply);
+        assert!(probe.pending_reply.is_none());
+        assert!(probe.receipt.screenshot_received.is_none());
+    }
