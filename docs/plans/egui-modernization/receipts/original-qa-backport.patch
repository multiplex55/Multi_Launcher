+    fn writer_does_not_overwrite_existing_png() {
+        let dir = tempfile::tempdir().unwrap();
+        let png = dir.path().join(PNG_FILE_NAME);
+        fs::write(&png, b"existing evidence").unwrap();
+        let (probe, _jobs, _outcome_tx) = test_probe(CaptureTrigger::Startup);
+        let mut receipt = probe.receipt;
+        receipt.captured = Some(evidence(2, 2, 0));
+        let image = Arc::new(ColorImage::new([1, 1], egui::Color32::WHITE));
+        let outcome = write_job(dir.path(), WriterJob::Save { receipt, image });
+        assert_eq!(outcome.status, ReceiptStatus::Failed);
+        assert_eq!(fs::read(png).unwrap(), b"existing evidence");
+        assert!(dir.path().join(RECEIPT_FILE_NAME).exists());
+    }
